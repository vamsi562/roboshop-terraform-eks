pipeline{
    agent{
        node{
            label 'agent-1'
        }
    } 
    environment{
        Course = 'DevOps'
    }
    options{
        timeout(time: 10, unit: 'MINUTES') 
        disableConcurrentBuilds()
        ansiColor('xterm') 
    }
    stages{
        stage('Init'){
            steps{
                script{ withAWS(credentials: 'aws-auth', region: 'us-east-1'){
                    sh """
                        cd 00-vpc
                        terraform init
                    """
                    }                      
                }
                
            }
        }
        stage('plan'){
            steps{
                script{ withAWS(credentials: 'aws-auth', region: 'us-east-1'){
                    sh """
                        cd 00-vpc
                        terraform plan
                    """
                    }                      
                }
                
            }
        }
        stage('Apply'){
            input {
                message "Should we continue?"
                ok "Yes, we should."
                submitter "alice,bob"
                parameters {
                    string(name: 'PERSON', defaultValue: 'Mr Jenkins', description: 'Who should I say hello to?')
                }
            }
            steps{
                script{ withAWS(credentials: 'aws-auth', region: 'us-east-1'){
                    sh """
                        cd 00-vpc
                        terraform apply -auto-approve
                    """
                    }                       
                }              
            }
        }
        stage('Trigger sg') {
            steps {
                build job: '10-sg', // downstream job name
                wait: false, // 00-vpc puts 10-sg into queue and continues to next step don't wait till 10-sg completed
                propagate: false // false - as failure of 10-sg does not fails 00-vpc
            }
        }
    }
    post{ 
        always{ 
            cleanWs()
        }
        success{ 
            echo 'succeeded'
        }
        failure{ 
            echo 'failed'
        }
        aborted{ 
            echo 'aborted'
        }
    }
}